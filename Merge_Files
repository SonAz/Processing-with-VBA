Sub GopTatCaSheet()
    Dim Sh As Worksheet, TgtSh As Worksheet
    Dim NextRow As Long
    
    Set TgtSh = Worksheets.Add(Before:=Worksheets(1))
    TgtSh.Name = "Tonghop"
    NextRow = 1
    
    For Each Sh In Worksheets
        If Sh.Name <> "Tonghop" Then
            Sh.UsedRange.Copy Destination:=TgtSh.Cells(NextRow, 1)
            NextRow = TgtSh.UsedRange.Rows.Count + 1
        End If
    Next Sh
    MsgBox "Đã gộp xong các sheet!"
End Sub
